# Stage 1: build the arch-specific artifacts that must not ship with their build deps
FROM debian:latest AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      busybox-static \
    && rm -rf /var/lib/apt/lists/*

COPY input/disableselinux.c /tmp/disableselinux.c
RUN mkdir /build \
    && gcc -shared -fPIC /tmp/disableselinux.c -o /build/libdisableselinux.so \
    && cp /bin/busybox /build/busybox

# Stage 2: the real rootfs — no build toolchain
FROM debian:latest

RUN printf '#!/bin/sh\nunset LD_PRELOAD\nunset LD_LIBRARY_PATH\nexport LIBGL_ALWAYS_SOFTWARE=1\n' \
    > /etc/profile.d/userland.sh && chmod +x /etc/profile.d/userland.sh

# systemd + systemd-sysv are a hard requirement of the AVF backend, not a
# convenience: avf-init pivot_roots into /lib/systemd/systemd and runs it as
# PID 1 when present, which is what makes `systemctl` -- and therefore Docker,
# podman and any packaged .service unit -- work inside the VM. Without them
# avf-init falls back to a chroot in which the distro's own init never runs and
# systemctl reports "System has not been booted with systemd as init system".
# Requested explicitly rather than left to chance: debian shipped systemd *unit
# files* but not the binary, and ubuntu/kali only got it as an incidental
# transitive dep -- either could silently regress and break init for every VM
# session. systemd-sysv provides the /sbin/init -> systemd link avf-init execs.
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd \
      systemd-sysv \
      sudo \
      dropbear \
      libgl1 \
      libglx-mesa0 \
      tightvncserver \
      xterm \
      xfonts-base \
      expect \
      wget \
      curl \
      pulseaudio \
    && apt-get install -y lxde dbus-x11 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# A polkit authentication agent only works where polkit can actually answer:
# it needs systemd-logind to own a session for the process and polkitd on the
# system bus. proot has no init, so neither exists, and lxpolkit greets every
# single login with a GTK error dialog reading "No session for pid <n>" --
# polkit's own message, from sd_pid_get_session() failing against an empty
# /run/systemd/sessions. XFCE never showed it because lxpolkit.desktop carries
# NotShowIn=...;XFCE;... and LXDE is not on that list.
#
# The same image also serves AVF/QEMU sessions, where systemd *is* running and
# the agent works normally, so this gates it at runtime rather than dropping it
# from the image. lxpolkit has two independent launchers -- lxsession's
# polkit/command and the XDG autostart entry -- and both must be routed through
# the wrapper or the other one still starts it.
RUN printf '%s\n' '#!/bin/sh' \
      '[ -d /run/systemd/system ] || exit 0' \
      'exec lxpolkit "$@"' > /usr/local/bin/lxpolkit-if-systemd \
    && chmod 755 /usr/local/bin/lxpolkit-if-systemd \
    && [ -f /etc/xdg/autostart/lxpolkit.desktop ] \
    && sed -i 's|^Exec=lxpolkit$|Exec=lxpolkit-if-systemd|; s|^TryExec=lxpolkit$|TryExec=lxpolkit-if-systemd|' \
         /etc/xdg/autostart/lxpolkit.desktop \
    && [ -f /etc/xdg/lxsession/LXDE/desktop.conf ] \
    && if grep -q '^polkit/command=' /etc/xdg/lxsession/LXDE/desktop.conf; then \
         sed -i 's|^polkit/command=.*|polkit/command=lxpolkit-if-systemd|' \
           /etc/xdg/lxsession/LXDE/desktop.conf; \
       else \
         sed -i '/^\[Session\]/a polkit/command=lxpolkit-if-systemd' \
           /etc/xdg/lxsession/LXDE/desktop.conf; \
       fi

COPY --from=builder /build/busybox              /support/busybox
COPY --from=builder /build/libdisableselinux.so /support/libdisableselinux.so
COPY assets/common/ /support/
COPY assets/debian/  /support/
COPY assets/lxde/   /support/

RUN chmod a+x /support/busybox \
              /support/libdisableselinux.so \
              /support/nosudo \
              /support/*.sh \
    && chmod a-w /support/* \
    && chmod a-w /support
