# The FoxBox app's image: userland-debian plus Firefox. Built on the base rather than from
# debian:latest so it carries the base's /support files and fixes; build-foxbox.yml rebuilds
# it whenever the base is rebuilt.
FROM ghcr.io/cypherpunkarmory/userland-debian:next

COPY apps/foxbox.sh /tmp/app.sh
RUN sh /tmp/app.sh && rm /tmp/app.sh
