# The free basic desktop for Ubuntu: userland-ubuntu plus openbox, a taskbar (tint2) and a file
# manager drawing the desktop (PCManFM), with Terminal, Firefox and Files on both, sized for the
# phone's screen (assets/desktop). Built on the base, like the app images, so the base stays
# small for terminal use and the apps built on it; build-ubuntu_basic.yml rebuilds it whenever
# the base is rebuilt.
FROM ghcr.io/cypherpunkarmory/userland-ubuntu:next

ENV DEBIAN_FRONTEND=noninteractive

# Ubuntu's own firefox is a stub that installs the snap, which can't run here: Firefox ESR comes
# from the Mozilla team's PPA (key 738BEB9321D1AAEC13EA9391AEBDF4819BE21867; apt rejects its older RSA-1024 one).
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x738BEB9321D1AAEC13EA9391AEBDF4819BE21867" \
         -o /etc/apt/keyrings/mozillateam.asc \
    && . /etc/os-release \
    && echo "deb [signed-by=/etc/apt/keyrings/mozillateam.asc] https://ppa.launchpadcontent.net/mozillateam/ppa/ubuntu $VERSION_CODENAME main" \
         > /etc/apt/sources.list.d/mozillateam.list

# adwaita-icon-theme-legacy has the full-colour terminal and file manager icons; the current
# Adwaita has only symbolic ones.
RUN apt-get update && apt-get install -y --no-install-recommends \
      openbox \
      tint2 \
      pcmanfm \
      x11-xserver-utils \
      dbus-x11 \
      fonts-dejavu-core \
      adwaita-icon-theme \
      adwaita-icon-theme-legacy \
      firefox-esr \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY assets/desktop/ /usr/share/userland/desktop/
COPY assets/basic/ /support/

# Firefox's interface scale from the session (assets/desktop/firefox-userland.cfg).
RUN cp /usr/share/userland/desktop/firefox-autoconfig.js /usr/lib/firefox-esr/defaults/pref/userland-autoconfig.js \
    && cp /usr/share/userland/desktop/firefox-userland.cfg /usr/lib/firefox-esr/userland.cfg

RUN chmod a+x /usr/share/userland/desktop/*.sh /support/startVNCServerStep2.sh \
    && chmod a-w /usr/share/userland/desktop/* /support/startVNCServerStep2.sh
