# The GIMP app's image: userland-debian plus GIMP. Built on the base rather than from
# debian:latest so it carries the base's /support files and fixes; build-gimp.yml rebuilds
# it whenever the base is rebuilt.
FROM ghcr.io/cypherpunkarmory/userland-debian:next

COPY apps/gimp.sh /tmp/app.sh
RUN sh /tmp/app.sh && rm /tmp/app.sh
