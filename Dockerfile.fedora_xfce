# Stage 1: build the arch-specific artifacts that must not ship with their build deps.
# Built on Fedora itself so libdisableselinux.so links against the same glibc it
# is preloaded into.
FROM fedora:latest AS builder

RUN dnf install -y --setopt=install_weak_deps=False gcc busybox \
    && dnf clean all

COPY input/disableselinux.c /tmp/disableselinux.c
RUN mkdir /build \
    && gcc -shared -fPIC /tmp/disableselinux.c -o /build/libdisableselinux.so \
    && cp /usr/sbin/busybox /build/busybox

# Stage 2: the real rootfs — no build toolchain
FROM fedora:latest

RUN printf '#!/bin/sh\nunset LD_PRELOAD\nunset LD_LIBRARY_PATH\nexport LIBGL_ALWAYS_SOFTWARE=1\n' \
    > /etc/profile.d/userland.sh && chmod +x /etc/profile.d/userland.sh

# systemd is a hard requirement of the AVF backend, not a convenience: avf-init
# pivot_roots into /lib/systemd/systemd and runs it as PID 1 when present, which
# is what makes `systemctl` -- and therefore Docker, podman and any packaged
# .service unit -- work inside the VM. The fedora container image leaves it out,
# and dbus-broker with it: without a system bus, dbus.socket and logind fail,
# the system comes up "degraded", and systemctl run as the user cannot connect.
#
# Fedora has no tightvncserver; tigervnc-x11-server provides Xvnc and
# tigervnc-server-common vncpasswd, which assets/fedora/startVNCServerStep2.sh
# drives directly. twm is no longer packaged, so openbox stands in as the
# minimal image's window manager.
RUN dnf install -y --setopt=install_weak_deps=False \
      systemd \
      dbus-broker \
      sudo \
      passwd \
      util-linux \
      procps-ng \
      hostname \
      iproute \
      which \
      less \
      nano \
      dropbear \
      tigervnc-x11-server \
      tigervnc-server-common \
      xterm \
      openbox \
      xsetroot \
      xorg-x11-fonts-misc \
      dejavu-sans-mono-fonts \
      mesa-dri-drivers \
      mesa-libGL \
      wget \
      pulseaudio-utils \
    && dnf group install -y --setopt=install_weak_deps=False xfce-desktop \
    && dnf install -y --setopt=install_weak_deps=False dbus-x11 \
    && dnf clean all

# Like lxpolkit in the LXDE images: a polkit authentication agent only works
# where systemd-logind owns a session for it and polkitd is on the system bus.
# proot has neither, so xfce-polkit greeted every login with an "XFCE PolicyKit
# Agent" error dialog. xfce4-session depends on the package, so it stays; its
# autostart entry is routed through a wrapper that starts it only where systemd
# is running -- AVF/QEMU sessions, which share this image.
RUN printf '%s\n' '#!/bin/sh' \
      '[ -d /run/systemd/system ] || exit 0' \
      'exec /usr/libexec/xfce-polkit "$@"' > /usr/local/bin/xfce-polkit-if-systemd \
    && chmod 755 /usr/local/bin/xfce-polkit-if-systemd \
    && grep -q '^Exec=/usr/libexec/xfce-polkit' /etc/xdg/autostart/xfce-polkit.desktop \
    && sed -i 's|^Exec=/usr/libexec/xfce-polkit|Exec=/usr/local/bin/xfce-polkit-if-systemd|' \
         /etc/xdg/autostart/xfce-polkit.desktop

COPY --from=builder /build/busybox              /support/busybox
COPY --from=builder /build/libdisableselinux.so /support/libdisableselinux.so
COPY assets/common/ /support/
COPY assets/fedora/ /support/
COPY assets/fedora_xfce/ /support/

RUN chmod a+x /support/busybox \
              /support/libdisableselinux.so \
              /support/nosudo \
              /support/userland-session \
              /support/*.sh \
    && chmod a-w /support/* \
    && chmod a-w /support
