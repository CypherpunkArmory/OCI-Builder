# The free basic desktop for Fedora: userland-fedora plus a taskbar (tint2) and a file manager
# drawing the desktop (PCManFM) on its openbox, with Terminal, Firefox and Files on both, sized
# for the phone's screen (assets/desktop). Built on the base, like Debian's
# (Dockerfile.debian_basic); build-fedora_basic.yml rebuilds it whenever the base is rebuilt.

# Fedora retired tint2 (orphaned in 2023): build the release Alpine packages, without its
# settings tool (tint2conf, which needs GTK).
FROM fedora:latest AS tint2

RUN dnf install -y --setopt=install_weak_deps=False gcc gcc-c++ cmake make pkgconf-pkg-config bzip2 \
      cairo-devel pango-devel glib2-devel imlib2-devel librsvg2-devel startup-notification-devel \
      libXcomposite-devel libXdamage-devel libXinerama-devel libXrandr-devel libXrender-devel \
      gettext \
    && dnf clean all

ARG TINT2_VERSION=17.1.3
ARG TINT2_SHA512=3405c32fd3e19b6ccb690406f19a00f4e95357d3c761227ac4a30b42fa20ffeb8974165815c3a4d50ae874252e593ef4fe4e5af8a5adba3d8d2820a6f479c045
RUN curl -fsSL -o /tmp/tint2.tar.bz2 https://gitlab.com/nick87720z/tint2/-/archive/$TINT2_VERSION/tint2-$TINT2_VERSION.tar.bz2 \
    && echo "$TINT2_SHA512  /tmp/tint2.tar.bz2" | sha512sum -c - \
    && tar -xjf /tmp/tint2.tar.bz2 -C /tmp \
    && cmake -S /tmp/tint2-$TINT2_VERSION -B /tmp/build \
         -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
         -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_SYSCONFDIR=/etc \
         -DENABLE_TINT2CONF=OFF -DENABLE_EXAMPLES=OFF \
    && cmake --build /tmp/build -j"$(nproc)" \
    && DESTDIR=/out cmake --install /tmp/build

FROM ghcr.io/cypherpunkarmory/userland-fedora:next

# adwaita-icon-theme-legacy has the full-colour terminal and file manager icons; the current
# Adwaita has only symbolic ones. The rest are tint2's libraries.
RUN dnf install -y --setopt=install_weak_deps=False \
      pcmanfm \
      xrdb \
      dbus-x11 \
      dejavu-sans-fonts \
      adwaita-icon-theme \
      adwaita-icon-theme-legacy \
      firefox \
      cairo pango imlib2 librsvg2 startup-notification \
      libXcomposite libXdamage libXinerama libXrandr \
    && dnf clean all

COPY --from=tint2 /out/usr/bin/tint2 /usr/bin/tint2

# Fonts for the app's languages and Firefox's language packs (input/locale)
COPY input/locale/desktop.sh /tmp/desktop.sh
RUN sh /tmp/desktop.sh firefox && rm /tmp/desktop.sh

COPY assets/desktop/ /usr/share/userland/desktop/
COPY assets/fedora_basic/ /support/

# Firefox's interface scale from the session (assets/desktop/firefox-userland.cfg), and its
# icon by the name Fedora gives it.
RUN ff=$(dirname "$(ls /usr/lib*/firefox/application.ini | head -1)") \
    && cp /usr/share/userland/desktop/firefox-autoconfig.js $ff/defaults/pref/userland-autoconfig.js \
    && cp /usr/share/userland/desktop/firefox-userland.cfg $ff/userland.cfg \
    && sed -i 's/^Icon=.*/Icon=firefox/' /usr/share/userland/desktop/firefox.desktop

RUN chmod a+x /usr/share/userland/desktop/*.sh /support/userland-session \
    && chmod a-w /usr/share/userland/desktop/* /support/userland-session
